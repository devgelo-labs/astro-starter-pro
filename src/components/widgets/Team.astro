---
import WidgetWrapper from "./WidgetWrapper.astro";
import Headline from "@/components/ui/Headline.astro";
import { Icon } from "astro-icon/components";
import type { TeamProps } from "@/types/types";

const {
  title = await Astro.slots.render("title"),
  subtitle = await Astro.slots.render("subtitle"),
  tagline,
  members = [],
  columns = 4,
  id,
  isDark = false,
  classes = {},
  bg = await Astro.slots.render("bg"),
  animate = true,
} = Astro.props as TeamProps;

const gridCols = {
  2: "sm:grid-cols-2",
  3: "sm:grid-cols-2 lg:grid-cols-3",
  4: "sm:grid-cols-2 lg:grid-cols-4",
};
---

<WidgetWrapper
  id={id}
  isDark={isDark}
  containerClass={`max-w-6xl mx-auto ${classes?.container ?? ""}`}
  bg={bg}
  animate={animate}
>
  <Headline
    title={title}
    subtitle={subtitle}
    tagline={tagline}
    classes={classes?.headline}
  />

  <div class={`grid gap-6 ${gridCols[columns]}`}>
    {members.map(({ name, role, image, bio, socials = [] }) => (
      <div class="flex flex-col items-center text-center p-6 rounded-xl shadow-[0_4px_30px_rgba(0,0,0,0.1)] backdrop-blur border border-black/5 dark:border-white/10 bg-white/50 dark:bg-slate-900/50">
        {image ? (
          <div class="h-24 w-24 rounded-full border border-slate-200 dark:border-slate-700 overflow-hidden shrink-0">
            <img
              src={image}
              alt={name}
              class="h-full w-full object-cover"
              loading="lazy"
            />
          </div>
        ) : (
          <div class="h-24 w-24 rounded-full bg-primary/10 text-primary flex items-center justify-center text-3xl font-bold shrink-0">
            {name.charAt(0).toUpperCase()}
          </div>
        )}

        <div class="mt-4 text-lg font-semibold leading-tight">{name}</div>
        <div class="text-sm text-primary mt-1">{role}</div>

        {bio && <p class="text-sm text-muted-foreground mt-3">{bio}</p>}

        {socials.length > 0 && (
          <div class="flex items-center gap-3 mt-auto pt-4">
            {socials.map(({ icon, href, label }) => (
              <a
                href={href}
                aria-label={label}
                class="text-muted-foreground hover:text-primary transition-colors"
              >
                <Icon name={icon} class="h-5 w-5" />
              </a>
            ))}
          </div>
        )}
      </div>
    ))}
  </div>
</WidgetWrapper>
